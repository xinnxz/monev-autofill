# ── Gemini API (penyusun isi logbook) ─────────────────────────────
# Buat di https://aistudio.google.com/apikey (gratis).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Dipakai kalau model utama sedang sibuk.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Posisi magang kamu, dipakai sebagai konteks penulisan.
ROLE=Software Engineer
# Latar proyek untuk Gemini (bukan sumber aktivitas). Salin konteks.example.md → konteks.md.
CONTEXT_FILE=konteks.md

# ── Sumber aktivitas ──────────────────────────────────────────────
# GitHub (sumber utama): username kamu. Token opsional kalau sudah "gh auth login";
# kalau tidak, buat classic token scope "repo" di github.com/settings/tokens.
GITHUB_USER=
GITHUB_TOKEN=

# Clone lokal (opsional, menambah commit yang belum di-push).
# Folder repo, pisahkan dengan ";". Boleh folder induk: semua subfolder yang
# berisi .git ikut dibaca.
REPOS=
# Nama atau email author git kamu (lihat: git config user.name)
GIT_AUTHOR=
# Folder catatan (markdown) yang file-nya berubah hari itu ikut dihitung.
NOTES_DIRS=
# Catatan manual untuk kegiatan yang tidak ada di git (meeting, diskusi, WFO).
# Tulis di catatan/YYYY-MM-DD.md; folder ini dibaca otomatis.
MANUAL_NOTES_DIR=./catatan

# Opsional: pertanyaanmu ke Claude Code hari itu (riwayat lokal ~/.claude/projects).
# Isi nama folder proyek kerja yang diizinkan, pisahkan ";" (misal: Dash;kantor-api).
# Kosong = mati. Hanya pertanyaanmu yang diambil, dipotong, dan rahasia disamarkan,
# lalu dikirim ke Gemini. Jangan izinkan folder proyek pribadi.
CLAUDE_CODE_PROJECTS=
# Regex topik yang diabaikan (misal obrolan di luar pekerjaan).
CLAUDE_CODE_EXCLUDE=

# Opsional: pesan Slack kamu hari itu (standup, thread tim).
# Butuh user token (xoxp-...) dengan scope search:read, dan user ID kamu (U...).
SLACK_USER_TOKEN=
SLACK_USER_ID=

# ── Notifikasi ke HP (isi salah satu atau keduanya) ───────────────
# Telegram: buat bot di @BotFather, lalu ambil chat id dari @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: install app ntfy, subscribe ke topik acak yang panjang (jangan ditebak orang).
NTFY_TOPIC=

# ── Portal ────────────────────────────────────────────────────────
MONEV_URL=https://monev.maganghub.kemnaker.go.id/dashboard/riwayat?date={date}&view=edit
# Pakai Chrome yang terpasang (lokasi asli lewat Windows Location Service).
BROWSER_CHANNEL=chrome
# Tanggal libur/izin/sakit (YYYY-MM-DD, pisahkan ";"): agent tidak mengisi apa pun.
OFF_DAYS=2026-12-25

# Panjang isi per kolom: pendek (120-250) | sedang (300-500) | panjang (500-900 karakter)
LENGTH=sedang
